# ==========================================
# Git Ignore for AI Security CCTV & Face Recognition System
# ==========================================

# --- Python Bytecode & Runtime Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Testing & Code Quality ---
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.cache
.tox/
.nox/
.mypy_cache/
.pyre/
.pytype/

# --- Runtime Vector Database & Cache ---
data/chroma_db/
!data/chroma_db/.gitkeep

# Intruder snapshots and incident evidence (captured dynamically)
data/intruders/*
!data/intruders/.gitkeep
data/evidence/*
!data/evidence/.gitkeep

# Model weights (auto-downloaded on first run from OpenCV Zoo)
data/models/*.onnx
data/models/*.yml
!data/models/.gitkeep

# Incident audit logs (generated dynamically at runtime)
data/audit_log.json

# --- Media Recordings & Snapshots ---
*.avi
*.mp4
*.mkv
*.mov
*.wav
*.mp3

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Environment Variables & Sensitive Credentials ---
.env
.env.*
*.secret
*.pem
*.key

# --- Operating System Files ---
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Distribution & Build ---
build/
dist/
*.egg-info/
.eggs/
*.egg
